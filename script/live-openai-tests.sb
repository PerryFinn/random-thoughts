(version 1)
(allow default)
(deny process-exec (require-not (literal (param "TEST_RUNNER"))))
(deny network*)
; The live test access also pins the exact official HTTPS endpoints and model.
(allow network-outbound (remote tcp "*:443") (remote udp "*:53") (remote tcp "*:53"))
(deny mach-lookup (global-name-regex #".*[Bb]luetooth.*"))
(deny mach-lookup (global-name "com.apple.cfprefsd.agent"))
(deny file-read-data
    (require-all
        (subpath (param "USER_HOME"))
        (require-not (subpath (param "WORKSPACE")))))
(deny file-read-data (literal (param "ENV_FILE")))
(deny file-write* (require-all
    (require-not (subpath (param "TEST_ROOT")))
    (require-not (literal "/dev/null"))))
