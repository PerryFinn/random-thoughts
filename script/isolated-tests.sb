(version 1)
(allow default)

; Only the hostless test runner can execute. No app, Codex or other subprocess.
(deny process-exec (require-not (literal (param "TEST_RUNNER"))))
(deny network*)
(deny mach-lookup (global-name-regex #".*[Bb]luetooth.*"))
(deny mach-lookup (global-name "com.apple.cfprefsd.agent"))

; Read shared code and the runner, never production user data. All writes are temporary.
(deny file-read-data
    (require-all
        (subpath (param "USER_HOME"))
        (require-not (subpath (param "WORKSPACE")))))
(deny file-write* (require-not (subpath (param "TEST_ROOT"))))
